  "tools": [
    {
      "name": "chart",
      "capability_id": "chart",
      "description": "Geocentric chart with explicit time/location/profile and provenance",
      "request_defaults": {},
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "request": {
            "$ref": "#/$defs/ChartRequest"
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false,
        "$defs": {
          "ChartRequest": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{2}:\\d{2}(:\\d{2}(\\.\\d{1,6})?)?$"
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "zodiac": {
                "type": "string",
                "enum": [
                  "tropical",
                  "sidereal"
                ],
                "default": "tropical"
              },
              "ayanamsa": {
                "type": "string",
                "enum": [
                  "lahiri",
                  "raman",
                  "krishnamurti",
                  "fagan-bradley"
                ],
                "default": "lahiri"
              },
              "house_system": {
                "type": "string",
                "enum": [
                  "placidus",
                  "whole-sign",
                  "equal",
                  "koch",
                  "regiomontanus",
                  "campanus",
                  "porphyry"
                ],
                "default": "placidus"
              },
              "node_type": {
                "type": "string",
                "enum": [
                  "true",
                  "mean"
                ],
                "default": "true"
              },
              "ephemeris_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "date",
              "latitude",
              "longitude",
              "timezone"
